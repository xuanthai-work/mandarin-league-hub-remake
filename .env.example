# Copy to .env.local and fill in. Never commit real secrets.

# --- Public (browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server only (hosting environment variables) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email sending (Resend). Auth emails use Supabase Auth SMTP settings.
RESEND_API_KEY=

# Drizzle CLI migrations (optional; DATABASE_URL falls back to DIRECT_URL)
DATABASE_URL=
DIRECT_URL=
