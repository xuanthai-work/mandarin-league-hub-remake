# Copy to .env.local and fill in. Never commit real secrets.

# --- Public (browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server only (hosting environment variables) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email sending (currently via Lovable email service).
# When leaving Lovable, replace with your own provider key (e.g. RESEND_API_KEY).
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
