# Copy to .env.local and fill in. Never commit real secrets.
# On Vercel: Settings → Environment Variables (Production + Preview), then redeploy.
# Admin → Cài đặt → Hệ thống shows which of these are missing (names only, never values).

# --- Public (browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server only) ---
# Required: admin actions, account creation, applicant files.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- reCAPTCHA v2 (server only) ---
# Required: without it every public form (recruitment, course and activity
# registration, certificate/HSK lookup) rejects all submissions.
# Secret of the site whose site key is RECAPTCHA_SITE_KEY in src/components/Recaptcha.tsx.
RECAPTCHA_SECRET_KEY=

# --- Email (Resend) ---
# Required for result emails (recruitment, course and activity reviews).
# Auth emails use Supabase Auth SMTP settings instead.
RESEND_API_KEY=
# Optional sender; its domain must be verified in Resend.
# Default: The Mandarin League <noreply@themandarinleague.bond>
RESEND_FROM=

# --- AI (server only, optional) ---
# Internal AI (Google Gemini): applicant summary, onboarding plans, certificate extraction.
# Separate key from GOOGLE_API_KEY so the public assistant's quota never blocks internal tools.
GOOGLE_AI_INTERNAL_KEY=
# Public TML AI assistant (Google Gemini).
GOOGLE_API_KEY=

# Google OAuth Web client ID (public). Members link their Google account in Settings;
# heads read Google Meet attendance with it. Create it in Google Cloud > Credentials.
GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth client secret (server only) for exchanging the bot refresh token.
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token of the Google bot account that owns the official Meet rooms.
MEET_BOT_REFRESH_TOKEN=
# Auth user id of the service account that scores attendance; admin flag, no member profile.
MEET_SCORER_USER_ID=
# Secret for daily cron scan (random string >= 16 chars; sent as Bearer token by Vercel Cron).
CRON_SECRET=
