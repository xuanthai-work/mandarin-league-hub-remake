# Copy to .env.local and fill in. Never commit real secrets.
# On Vercel: Settings → Environment Variables (Production + Preview), then redeploy.
# Admin → Cài đặt → Hệ thống shows which of these are missing (names only, never values).

# --- Public (browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server only) ---
# Required: admin actions, account creation, applicant files.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- reCAPTCHA v2 (server only) ---
# Required: without it every public form (recruitment, course and activity
# registration, certificate/HSK lookup) rejects all submissions.
# Secret of the site whose site key is RECAPTCHA_SITE_KEY in src/components/Recaptcha.tsx.
RECAPTCHA_SECRET_KEY=

# --- Email (Resend) ---
# Required for result emails (recruitment, course and activity reviews).
# Auth emails use Supabase Auth SMTP settings instead.
RESEND_API_KEY=
# Optional sender; its domain must be verified in Resend.
# Default: The Mandarin League <noreply@themandarinleague.bond>
RESEND_FROM=

# --- AI (server only, optional) ---
# Internal AI: applicant summary, onboarding plans, certificate extraction.
LOVABLE_API_KEY=
# Public TML AI assistant (Gemini).
GOOGLE_API_KEY=

# --- Drizzle CLI migrations (optional, local only) ---
# DATABASE_URL falls back to DIRECT_URL, then LOVABLE_DB_MIGRATION_URL.
DATABASE_URL=
DIRECT_URL=
LOVABLE_DB_MIGRATION_URL=
