# pnpm is the only supported package manager for this repo.
#
# 24h supply-chain guard (mirrors the old bunfig.toml): skip package versions
# published less than a day ago.
minimum-release-age=1440

# Tooling that ships platform binaries with the framework packages we track
# (a fresh tailwind release would otherwise block the whole install).
minimum-release-age-exclude[]=@tailwindcss/*
minimum-release-age-exclude[]=@napi-rs/*
minimum-release-age-exclude[]=@rolldown/*
minimum-release-age-exclude[]=@esbuild/*
minimum-release-age-exclude[]=@oxc-project/*
minimum-release-age-exclude[]=lightningcss-*
